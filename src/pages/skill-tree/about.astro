---
// About the career skill tree: what it is, how to read it, and how it's built, drawn as
// a short build order on graph paper, one tier per step (design/PLAN.md, "The about
// page"). Counts come from the same data file the tree is drawn from.
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import { nodes, tracks, timeTicks } from '../../data/skill-tree';
import liveLinks from '../../data/links.json';
import '../../styles/theme.css';

const visible = nodes.filter((n) => n.status !== 'secret');
const skills = visible.filter((n) => (n.kind ?? 'skill') === 'skill').length;
const milestones = visible.length - skills;
const withStory = new Set(visible.filter((n) => n.read).map((n) => n.read)).size;
const live = Object.keys(liveLinks as Record<string, unknown>).length;
const firstYear = timeTicks[0];
const tiers = ['I', 'II', 'III', 'IV', 'V'];

// The build order: one step per tier, each building on the one above it.
const steps = [
  {
    glyph: 'DAT',
    name: 'One file holds the whole career',
    where: 'A data file in the site’s code',
    body: [
      `Every track, skill and milestone is an entry in one file: its name, the year it started, how strong it is, what it builds on, and which row and column it sits in. Right now that’s ${tracks.length} tracks, ${skills} skills and ${milestones} milestones.`,
      'Nothing is drawn by hand. To change the tree, I change that file.',
    ],
  },
  {
    glyph: 'DRW',
    name: 'The boards are drawn when the site is built',
    where: 'The build, before the page reaches you',
    body: [
      'Each track becomes a drawing: a skill’s row is its tier, its column is where it sits across the board, and a line runs up to whatever it builds on. A small colored dot marks a skill that also builds on another track.',
      'Because the drawings are made ahead of time, the tree is already there when the page opens, before any script runs.',
    ],
  },
  {
    glyph: 'PLY',
    name: 'Your browser adds the play',
    where: 'Your phone or computer',
    body: [
      `A script handles the parts you touch: picking a track, opening a skill’s notes, and the replay. The replay walks a timeline from ${firstYear} to now and fills in each skill in the year it started. The long early years are squeezed and the busy recent ones get more room, which is why the timeline isn’t to scale.`,
    ],
  },
  {
    glyph: 'LNK',
    name: '“Read” links wait for the writing',
    where: 'A check before every build, and once a week',
    body: [
      `${withStory} skills point to a longer story on kylepace.net, a post or a case study. A skill only shows its link once that page is public there. A small script checks, before every build and every week, so a story I publish shows up here without anyone touching the tree. ${live} are live so far.`,
      'If kylepace.net can’t be reached, the last list is kept.',
    ],
  },
  {
    glyph: 'SHP',
    name: 'It ships as its own small site',
    where: 'Cloudflare, at kylepace.dev/skill-tree',
    body: [
      'The skill tree is separate from the rest of kylepace.dev: its own code, its own look, and its own place on the same address. Every saved change rebuilds it. There’s no database and no account. The pages are plain files.',
    ],
  },
];
---

<LabLayout
  title="How the skill tree works"
  description="What Kyle Pace’s career skill tree is, how to read it, and how it’s built: one data file, boards drawn at build time, and a replay that runs in your browser."
  image="/skill-tree/og-about.png"
  imageAlt="How the skill tree works: five steps drawn as a build order on blueprint graph paper, from one data file to its own small site."
  themeColor={{ light: '#eef2f5', dark: '#0f2135' }}
>
  <a slot="bar" class="about-link" href="/skill-tree/">The tree</a>

  <article class="about-page">
    <h1 class="title">How the skill tree works</h1>

    <section aria-labelledby="what-title">
      <h2 id="what-title">What it is</h2>
      <p>
        A resume is a list. Careers feel more like a game: you pick up skills in odd places, and they combine in ways you don’t expect.
        Thirteen years in restaurants turned out to be great training for stakeholder management.
        So <a href="/skill-tree/">this is my career drawn as a skill tree</a>.
      </p>
    </section>

    <section aria-labelledby="read-title">
      <h2 id="read-title">How to read it</h2>
      <p>
        Each track is one line of work. Skills near the top came first, and the lines show what each one built on. A star marks a signature
        strength, a dashed ring is a skill I’m still developing, squares are milestones like a new role or a degree, and the larger circle
        at the bottom of a track is its capstone. Pick any skill to read where it came from, or press Replay my career to watch the tree
        fill in year by year.
      </p>
    </section>

    <section aria-labelledby="built-title">
      <h2 id="built-title">How it’s built</h2>
      <ol class="build">
        {
          steps.map((step, i) => (
            <li>
              <span class="tier" aria-hidden="true">{tiers[i]}</span>
              <span class="node" aria-hidden="true">{step.glyph}</span>
              <div class="entry">
                <h3>{step.name}</h3>
                <p class="where"><span class="visually-hidden">Where it runs: </span>{step.where}</p>
                {step.body.map((text) => <p>{text}</p>)}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="notes-title">
      <h2 id="notes-title">Notes</h2>
      <p>
        The levels are my own honest read, not a test score. The attributes are not. The whole thing is still being refined.
      </p>
      <p>
        Nothing you pick or replay is saved. Analytics works the same as the rest of kylepace.dev: anonymous, no cookies, and you can turn
        it off (<a href="https://kylepace.dev/privacy/">privacy</a>).
      </p>
      <p>
        The code is public: <a href="https://github.com/kyle-pace/skill-tree">github.com/kyle-pace/skill-tree</a>.
      </p>
    </section>
  </article>
</LabLayout>

<style>
  .about-page {
    width: min(100% - 2 * var(--gutter), 84rem);
    margin-inline: auto;
    padding-bottom: var(--space-12);
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    margin-inline-end: calc(-1 * var(--space-2));
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .about-link:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  /* The form's printed title, the same as the tree's page. */
  .title {
    margin-block: var(--space-2) var(--space-8);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  section {
    margin-bottom: var(--space-12);
  }

  /* Section names are printed on a ruled line, like the headings of a form. */
  h2 {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-1);
    max-width: 44rem;
    border-bottom: 2px solid var(--ink);
    font-size: var(--step-1);
    font-weight: 700;
  }

  p {
    max-width: 36rem;
    margin: 0 0 var(--space-3);
  }

  a {
    color: var(--accent-ink);
    text-underline-offset: 0.15em;
  }

  /* ---------- The build order: a five-tier track on graph paper ---------- */
  .build {
    --node: 3.25rem;
    list-style: none;
    max-width: 44rem;
    margin: 0;
    padding: var(--space-6) var(--space-4) var(--space-6) var(--space-2);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: var(--grid) var(--grid);
    background-position: -1px -1px;
  }

  .build li {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem var(--node) minmax(0, 1fr);
    gap: 0 var(--space-3);
    align-items: start;
    padding-bottom: var(--space-8);
  }

  .build li:last-child {
    padding-bottom: 0;
  }

  /* The line from each step down to the one that builds on it. */
  .build li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(1.75rem + var(--space-3) + var(--node) / 2 - 1px);
    top: var(--node);
    bottom: 0;
    width: 2px;
    background: var(--ink);
  }

  /* Tier numerals down the margin, as on the tree. */
  .tier {
    padding-top: calc(var(--node) / 2 - 0.7em);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--ink-muted);
    text-align: right;
  }

  .node {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    box-sizing: border-box;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--bg-raised);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* The first step is where the track starts, so it's a milestone: a square. The last is
     the capstone: a larger, double-ringed circle. */
  .build li:first-child .node {
    border-radius: var(--radius);
  }

  .build li:last-child .node {
    box-shadow:
      0 0 0 3px var(--bg),
      0 0 0 5px var(--ink);
  }

  /* Each entry is an index card pressed onto the paper, so its text never sits on the grid. */
  .entry {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .entry h3 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.25;
  }

  /* Where it runs: a filled-in blank with the answer on the line, like the sheet's fields. */
  .where {
    margin: var(--space-2) 0 var(--space-3);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .entry p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 32rem) {
    .build {
      --node: 2.75rem;
      padding-inline: var(--space-1) var(--space-2);
    }

    .build li {
      grid-template-columns: 1.25rem var(--node) minmax(0, 1fr);
      gap: 0 var(--space-2);
    }

    .build li:not(:last-child)::before {
      left: calc(1.25rem + var(--space-2) + var(--node) / 2 - 1px);
    }

    .entry {
      padding: var(--space-2) var(--space-3);
    }
  }
</style>
